rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToCompany(companyId) {
      return signedIn() && hasUserDoc() && userDoc().companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return belongsToCompany(companyId)
        && userDoc().role in ['super_admin', 'admin'];
    }

    // Effective People sub-role; empty string means "fall back to the global role".
    // Guarded with `is map` because a null/absent field would make .get() error out,
    // which rules treat as a denial.
    function peopleSubRole() {
      return userDoc().get('portalSubRoles', {}) is map
        ? userDoc().get('portalSubRoles', {}).get('people', '')
        : '';
    }

    function customPermissions() {
      return userDoc().get('customPermissions', []) is list
        ? userDoc().get('customPermissions', [])
        : [];
    }

    // Mirrors the `people.view_all_reports` permission in src/lib/permissions.
    // Everyone can always read their own reports; this covers reading everyone's.
    function canViewAllReports(companyId) {
      return belongsToCompany(companyId) && (
        userDoc().role == 'super_admin'
        || 'people.view_all_reports' in customPermissions()
        || (
          userDoc().role in ['admin', 'manager']
          && (peopleSubRole() == '' || peopleSubRole() in ['admin', 'manager', 'hr'])
        )
      );
    }

    // Fields that decide what a user can reach. Only company admins, or the
    // founding / invite-acceptance flows below, may set them.
    function privilegedUserKeys() {
      return ['role', 'companyId', 'portalAccess', 'portalSubRoles', 'customPermissions'];
    }

    function companyDocPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    function signedInEmail() {
      return request.auth.token.get('email', '') is string
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    // Registration / Google sign-up founds a brand-new company. The company must
    // not exist before this write and must exist after it, so the profile and the
    // company are written together in one batch. This is what stops someone from
    // typing an existing company's name and becoming its admin.
    function foundsNewCompany(data) {
      return data.role == 'admin'
        && data.companyId is string
        && data.companyId.size() > 0
        && !exists(companyDocPath(data.companyId))
        && existsAfter(companyDocPath(data.companyId));
    }

    // Joining an existing company requires a pending invite addressed to the
    // signed-in email, and the profile must match it field for field.
    function inviteMatches(invite, data) {
      return invite.status == 'pending'
        && invite.email.lower() == signedInEmail()
        && invite.companyId == data.companyId
        && invite.role == data.role
        && (!('expiresAtTs' in invite) || invite.expiresAtTs > request.time)
        && data.get('portalAccess', []) == (invite.get('portalAccess', null) == null ? [] : invite.portalAccess)
        && data.get('portalSubRoles', {}) == (invite.get('portalSubRoles', null) == null ? {} : invite.portalSubRoles)
        && data.get('customPermissions', []) == [];
    }

    function acceptsInvite(data) {
      return data.get('inviteToken', '') is string
        && data.get('inviteToken', '') != ''
        && exists(/databases/$(database)/documents/invites/$(data.inviteToken))
        && inviteMatches(get(/databases/$(database)/documents/invites/$(data.inviteToken)).data, data);
    }

    // User profiles
    match /users/{userId} {
      // Own profile, or teammates in the same company
      allow read: if signedIn() && (
        request.auth.uid == userId
        || (hasUserDoc() && resource.data.companyId == userDoc().companyId)
      );

      // New account: either founding a new company or accepting an invite.
      allow create: if signedIn()
        && request.auth.uid == userId
        && (foundsNewCompany(request.resource.data) || acceptsInvite(request.resource.data));

      allow update: if signedIn() && (
        // Self: profile fields only, never role, company or permissions
        (request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(privilegedUserKeys()))
        // Company admin managing a teammate: can't move them to another company,
        // and only a super admin can hand out super admin.
        || (isCompanyAdmin(resource.data.companyId)
          && request.resource.data.companyId == resource.data.companyId
          && (request.resource.data.get('role', '') != 'super_admin'
            || resource.data.get('role', '') == 'super_admin'
            || userDoc().role == 'super_admin'))
      );

      allow delete: if hasUserDoc() && isCompanyAdmin(resource.data.companyId);
    }

    // Team invitations (token = document id)
    match /invites/{token} {
      // Accept page loads a single pending invite by token (pre-auth)
      allow get: if resource.data.status == 'pending'
        || (signedIn() && isCompanyAdmin(resource.data.companyId));

      // Admins list pending invites for their company (query must filter companyId)
      allow list: if signedIn() && isCompanyAdmin(resource.data.companyId);

      allow create: if signedIn()
        && isCompanyAdmin(request.resource.data.companyId)
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string
        && request.resource.data.token == token
        && (request.resource.data.role != 'super_admin' || userDoc().role == 'super_admin');

      allow update: if signedIn() && (
        (isCompanyAdmin(resource.data.companyId)
          && request.resource.data.companyId == resource.data.companyId)
        // The invitee marks their own invite accepted, and nothing else
        || (
          resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.auth.uid == request.resource.data.acceptedBy
          && resource.data.email.lower() == signedInEmail()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'acceptedAt', 'acceptedBy'])
        )
      );

      allow delete: if signedIn() && isCompanyAdmin(resource.data.companyId);
    }

    // OTP password-reset codes (EmailJS flow). OtpService is not wired into any
    // page; keep the collection closed instead of world-readable.
    match /otpResets/{id} {
      allow read, write: if false;
    }

    // Public invoice PDF shares (QR scan → PDF). No auth required to open.
    match /publicInvoiceShares/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.token == token
        && request.resource.data.companyId is string
        && request.resource.data.invoiceId is string
        && belongsToCompany(request.resource.data.companyId)
        && (
          request.resource.data.snapshot is map
          || request.resource.data.pdfUrl is string
          || request.resource.data.pdfBase64 is string
        );
      allow delete: if signedIn()
        && belongsToCompany(resource.data.companyId);
    }

    match /companies/{companyId} {
      allow read, write: if belongsToCompany(companyId);
      // Founding: only alongside creating your own profile for this company,
      // in the same batch (see foundsNewCompany).
      allow create: if signedIn()
        && !hasUserDoc()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId;

      // Allow public unauthenticated single GET for client reports (direct share link)
      match /client_reports/{reportId} {
        allow get: if true;
        allow list, write: if belongsToCompany(companyId);
      }

      // Daily reports are private: authors see their own, managers/HR/admins see all.
      // A list query is only permitted when it is filtered to the caller, which is
      // exactly what DailyReportsService does for non-privileged users.
      match /daily_reports/{reportId} {
        allow read: if belongsToCompany(companyId) && (
          resource.data.employeeId == request.auth.uid
          || canViewAllReports(companyId)
        );
        allow create: if belongsToCompany(companyId)
          && request.resource.data.employeeId == request.auth.uid;
        // Authors may amend their own report; managers add the review fields.
        // `resource != null` keeps this from erroring while a create is evaluated.
        allow update: if belongsToCompany(companyId) && resource != null && (
          resource.data.employeeId == request.auth.uid
          || canViewAllReports(companyId)
        );
        allow delete: if isCompanyAdmin(companyId);
      }

      // Every other company subcollection stays open to company members.
      // Rules are additive, so `daily_reports` must be excluded by name here —
      // otherwise this block would re-grant what the stricter rule above denies.
      match /{collection}/{docId} {
        allow read, write: if belongsToCompany(companyId)
          && collection != 'daily_reports';

        // Nested data such as tasks/{id}/comments and conversations/{id}/messages.
        match /{nested=**} {
          allow read, write: if belongsToCompany(companyId)
            && collection != 'daily_reports';
        }
      }
    }
  }
}
