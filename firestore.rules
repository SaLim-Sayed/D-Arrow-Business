rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function belongsToCompany(companyId) {
      return signedIn() && userDoc().companyId == companyId;
    }

    function isCompanyAdmin(companyId) {
      return belongsToCompany(companyId)
        && userDoc().role in ['super_admin', 'admin'];
    }

    // User profiles
    match /users/{userId} {
      // Own profile, or teammates in the same company
      allow read: if signedIn() && (
        request.auth.uid == userId
        || resource.data.companyId == userDoc().companyId
      );

      // New account (register / invite accept / Google)
      allow create: if signedIn() && request.auth.uid == userId;

      // Self update, or company admin updating teammates
      allow update: if signedIn() && (
        request.auth.uid == userId
        || isCompanyAdmin(resource.data.companyId)
      );

      allow delete: if isCompanyAdmin(resource.data.companyId);
    }

    // Team invitations (token = document id)
    match /invites/{token} {
      // Accept page loads a single pending invite by token (pre-auth)
      allow get: if resource.data.status == 'pending'
        || (signedIn() && isCompanyAdmin(resource.data.companyId));

      // Admins list pending invites for their company (query must filter companyId)
      allow list: if signedIn() && isCompanyAdmin(resource.data.companyId);

      allow create: if signedIn()
        && isCompanyAdmin(request.resource.data.companyId)
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string
        && request.resource.data.token == token;

      allow update: if signedIn() && (
        isCompanyAdmin(resource.data.companyId)
        || (
          resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.auth.uid == request.resource.data.acceptedBy
        )
      );

      allow delete: if signedIn() && isCompanyAdmin(resource.data.companyId);
    }

    // OTP password-reset codes (EmailJS flow)
    match /otpResets/{id} {
      allow read, write: if true;
    }

    // Public invoice PDF shares (QR scan → PDF). No auth required to open.
    match /publicInvoiceShares/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn()
        && request.resource.data.token == token
        && request.resource.data.companyId is string
        && request.resource.data.invoiceId is string
        && belongsToCompany(request.resource.data.companyId)
        && (
          request.resource.data.snapshot is map
          || request.resource.data.pdfUrl is string
          || request.resource.data.pdfBase64 is string
        );
      allow delete: if signedIn()
        && belongsToCompany(resource.data.companyId);
    }

    match /companies/{companyId} {
      allow read, write: if belongsToCompany(companyId);
      allow create: if signedIn();

      // ZATCA Phase 2 credentials (private key, certificate, CSID auth) and
      // the invoice hash-chain state. Written only by the server (Vercel
      // /api/zatca or optional Cloud Functions) via the Admin SDK, which
      // bypasses these rules entirely — so "false" here just means no client,
      // however privileged, can read or write them directly. Keep this ABOVE
      // the generic wildcard match below; a more specific match always wins
      // over a recursive one for the same path.
      match /zatcaSecrets/{envId} {
        allow read, write: if false;
      }
      match /zatcaChain/{docId} {
        allow read, write: if false;
      }

      match /{allSubcollections=**} {
        allow read, write: if belongsToCompany(companyId);
      }
    }
  }
}
